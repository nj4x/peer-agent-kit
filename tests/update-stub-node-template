#!/usr/bin/env bash
# Stub node for update.sh tests
# Handles manifest parsing only, passes everything else to real node

# Resolve the real node by scanning PATH, skipping the stub directories so the
# lookup can never resolve back to this script.
REAL_NODE=""
IFS=':' read -ra _path_dirs <<< "$PATH"
IFS=$' \t\n'
for _dir in "${_path_dirs[@]}"; do
  case "$_dir" in
    *test-stubs*|*tests/stubs*) continue ;;
  esac
  if [ -x "$_dir/node" ]; then
    REAL_NODE="$_dir/node"
    break
  fi
done

if [ -z "$REAL_NODE" ]; then
  echo "[test stub] error: node not found on PATH" >&2
  exit 127
fi
if [ ! -x "$REAL_NODE" ]; then
  echo "[test stub] error: node not executable at $REAL_NODE" >&2
  exit 127
fi

if [[ "$1" == "-e" ]]; then
  script="$2"
  
  # Fix #4: Only intercept pure read operations (scripts that ONLY read and console.log)
  # Manifest write scripts contain fs.writeFileSync or fs.renameSync - pass those through
  if [[ "$script" == *"fs.writeFileSync"* ]] || [[ "$script" == *"fs.renameSync"* ]]; then
    exec "$REAL_NODE" "$@"
  fi
  
  # Manifest read operations (extract fields) - only match pure read patterns
  if [[ "$script" == *"console.log(m.kitSha"* ]]; then
    mpath=$(echo "$script" | grep -oE "readFileSync\('([^']+)'|readFileSync\(\"([^\"]+)\"" | head -1 | sed "s/.*readFileSync('//;s/'.*//;s/.*readFileSync(\"//;s/\".*//")
    if [[ -n "$mpath" && -f "$mpath" ]]; then
      grep -o '"kitSha": *"[^"]*"' "$mpath" 2>/dev/null | sed 's/"kitSha": *"\([^"]*\)"/\1/' || echo ""
    else
      echo ""
    fi
    exit 0
  fi
  
  if [[ "$script" == *"console.log(m.claudeDir"* ]]; then
    mpath=$(echo "$script" | grep -oE "readFileSync\('([^']+)'|readFileSync\(\"([^\"]+)\"" | head -1 | sed "s/.*readFileSync('//;s/'.*//;s/.*readFileSync(\"//;s/\".*//")
    if [[ -n "$mpath" && -f "$mpath" ]]; then
      grep -o '"claudeDir": *"[^"]*"' "$mpath" | sed 's/"claudeDir": *"\([^"]*\)"/\1/' || echo "$HOME/.claude"
    else
      echo "$HOME/.claude"
    fi
    exit 0
  fi
  
  if [[ "$script" == *"console.log(m.pluginRoot"* ]]; then
    mpath=$(echo "$script" | grep -oE "readFileSync\('([^']+)'|readFileSync\(\"([^\"]+)\"" | head -1 | sed "s/.*readFileSync('//;s/'.*//;s/.*readFileSync(\"//;s/\".*//")
    if [[ -n "$mpath" && -f "$mpath" ]]; then
      grep -o '"pluginRoot": *"[^"]*"' "$mpath" | sed 's/"pluginRoot": *"\([^"]*\)"/\1/' || echo "$HOME/.claude"
    else
      echo "$HOME/.claude"
    fi
    exit 0
  fi
  
  if [[ "$script" == *"console.log(m.skillInstalledByKit"* ]]; then
    mpath=$(echo "$script" | grep -oE "readFileSync\('([^']+)'|readFileSync\(\"([^\"]+)\"" | head -1 | sed "s/.*readFileSync('//;s/'.*//;s/.*readFileSync(\"//;s/\".*//")
    if [[ -n "$mpath" && -f "$mpath" ]]; then
      grep -o '"skillInstalledByKit": *[^,}]*' "$mpath" | sed 's/"skillInstalledByKit": *//' || echo "false"
    else
      echo "false"
    fi
    exit 0
  fi
  
  # Pass through to real node for everything else
  exec "$REAL_NODE" "$@"
fi

# Default: pass through to real node
exec "$REAL_NODE" "$@"
